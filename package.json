{
  "name": "sentinelnms-desktop",
  "version": "1.0.0",
  "description": "SentinelNMS — Network Management System by Nav Wireless Technologies",
  "main": "desktop/main.js",
  "author": {
    "name": "Vardhan Suthar",
    "email": "var2611@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder --win --linux --mac"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.nmstool.app",
    "productName": "SentinelNMS",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "desktop/**/*",
      "api/**/*",
      "core/**/*",
      "frontend/dist/**/*",
      "requirements.txt",
      ".env.example",
      "!**/__pycache__",
      "!**/*.pyc",
      "!node_modules"
    ],
    "extraResources": [
      { "from": "venv", "to": "venv", "filter": ["**/*"] },
      { "from": "api", "to": "api" },
      { "from": "core", "to": "core" },
      { "from": "frontend/dist", "to": "frontend/dist" }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "desktop/icon.ico"
    },
    "linux": {
      "target": [{ "target": "deb", "arch": ["x64"] }, { "target": "AppImage", "arch": ["x64"] }],
      "icon": "desktop/icon.png",
      "category": "Network"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "icon": "desktop/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NMS-Tool"
    }
  }
}
