# NMS-Tool Server — Environment Variables
# Copy this to .env and fill in your values

POSTGRES_PASSWORD=changeme_use_strong_password
SECRET_KEY=change_this_to_a_long_random_string_in_production

# Email notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourcompany.com
SMTP_PASSWORD=your_app_password

# Webhook notifications (optional, works with Slack/Teams/Discord)
WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Sync gateway authorization (recommended in production)
# When set, every desktop agent must use this exact key in
# Settings -> Cloud Sync -> API key. When empty, any key is accepted.
# Generate one with:  openssl rand -hex 24
SYNC_API_KEY=
