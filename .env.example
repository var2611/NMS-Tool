# NMS-Tool Environment Configuration

# App Mode: "desktop" or "server"
APP_MODE=desktop

# API Settings
API_HOST=127.0.0.1
API_PORT=8765
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Desktop: uses SQLite
SQLITE_DB_PATH=./data/nms.db
# Server: uses PostgreSQL (uncomment below)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nmsdb

# SNMP Settings
SNMP_TRAP_PORT=162
SNMP_DEFAULT_COMMUNITY=public
SNMP_TIMEOUT=5
SNMP_RETRIES=2

# Cloud Sync (Desktop app - optional)
SYNC_ENABLED=false
SYNC_SERVER_URL=
SYNC_API_KEY=
SYNC_INTERVAL_MINUTES=5

# Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nms@yourdomain.com

# Webhook
WEBHOOK_URL=

# Logging
LOG_LEVEL=INFO
LOG_FILE=./data/nms.log
